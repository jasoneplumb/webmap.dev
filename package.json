{
  "name": "webmap-dev",
  "version": "0.52.3",
  "type": "module",
  "comment:test": "`test` shells out to bash for the deploy-script suite; `npm test` therefore needs bash (CI, macOS, Linux all have it — Windows needs WSL/Git Bash). Run `npx vitest run` alone to skip it. See docs/deployment.md.",
  "scripts": {
    "test": "vitest run && bash scripts/test-deploy-webmap.sh",
    "test:deploy-script": "bash scripts/test-deploy-webmap.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint src",
    "size": "size-limit",
    "og": "node scripts/generate-og-image.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "icons": "node scripts/generate-maskable-icons.mjs"
  },
  "dependencies": {
    "esri-leaflet": "^3.0.12",
    "esri-leaflet-geocoder": "^3.1.4",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@types/leaflet": "^1.9.14",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.0.1",
    "sharp": "^0.35.4",
    "size-limit": "^12.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "comment:overrides": "GHSA-4x5r-pxfx-6jf8 via vite-plugin-pwa -> workbox-build; drop when it resolves past 7.29.0 (see issue #320)",
  "overrides": {
    "@babel/core": "^7.29.7"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ]
}
